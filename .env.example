# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# People Data Labs
PDL_API_KEY=your_pdl_api_key

# The Swarm (Relationship Mapping)
SWARM_API_KEY=your_swarm_api_key

# Google OAuth (for Gmail/GCal)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenAI (for AI categorization)
OPENAI_API_KEY=your_openai_api_key

# App URL (for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin API Key (for /api/admin/* endpoints - generate a strong random string)
ADMIN_API_KEY=your_admin_api_key

# Cron Secret (for Vercel cron jobs - REQUIRED, routes will reject without it)
CRON_SECRET=your_cron_secret

# Database URL (for admin migrations - optional, only if using direct SQL migrations)
# DATABASE_URL=postgresql://...
